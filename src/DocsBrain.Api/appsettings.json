{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ai": {
    "Provider": "ollama",
    "OllamaUrl": "http://localhost:11434",
    "EmbeddingModel": "nomic-embed-text",
    "ChatModel": "llama3.2:3b"
  },
  "Search": {
    "MinSimilarity": 0.45
  },
  "Chat": {
    "DailyTokenBudget": 50000,
    "RequestsPerMinute": 20,
    "MaxSources": 5
  }
}
